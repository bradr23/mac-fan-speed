<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.bradr23.MacFanSpeed.helper</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/MacFanSpeedHelper</string>
	</array>

	<!-- launchd starts the daemon on demand when the app connects to this
	     Mach service, and again if it ever exits. -->
	<key>MachServices</key>
	<dict>
		<key>io.github.bradr23.MacFanSpeed.helper</key>
		<true/>
	</dict>

	<key>KeepAlive</key>
	<true/>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardErrorPath</key>
	<string>/var/log/MacFanSpeedHelper.log</string>

	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
